{
  "name": "second-year-dynamics",
  "version": "1.0.0",
  "private": true,
  "description": "MyST Markdown edition of the Fall 2025 Second-Year Dynamics textbook",
  "license": "CC-BY-NC-SA-4.0",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22",
    "npm": ">=10 <11"
  },
  "scripts": {
    "start": "myst start",
    "build": "myst build --html && node scripts/setup-pwa.mjs",
    "verify": "python3 scripts/verify_book.py",
    "check": "npm run verify && myst build --html --strict --check-links",
    "extract": "python3 scripts/convert_pdf.py"
  },
  "devDependencies": {
    "mystmd": "1.11.0",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  }
}
